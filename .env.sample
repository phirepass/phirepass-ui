NEXT_PUBLIC_WS_URL=wss://phirepass.com
NEXT_PUBLIC_GITHUB_CLIENT_ID=client_id
GITHUB_CLIENT_SECRET=client_secret
REDIS_DATABASE_URL=rediss://default:password@hostname:port
DATABASE_URL=postgres://user:password@hostname:port/database?sslmode=require
PGSSLROOTCERT=./certs/ca.pem
JWT_SECRET=supersecret
COOKIE_DOMAIN=.phirepass.com
# Two-factor authentication. Unset means "on in production, off elsewhere";
# set it either way to override, e.g. to try the flow against a dev server.
NEXT_PUBLIC_MFA_ENABLED=true
MAILER_API_KEY=sample
NEXT_PUBLIC_VAPID_PUBLIC_KEY=pub_key
VAPID_PRIVATE_KEY=key
VAPID_SUBJECT=mailto:subject@phirepass.io
